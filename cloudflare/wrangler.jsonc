{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taskdrop-sync-relay",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "kv_namespaces": [
    {
      "binding": "VAULTS",
      "id": "YOUR_KV_NAMESPACE_ID",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VAULT_ROOMS",
        "class_name": "VaultRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VaultRoom"],
    },
  ],
  "observability": {
    "enabled": true,
  },
}
